{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "mode": {
            "type": "string",
            "title": "Mode",
            "enum": ["pub", "sub"]
        },
        "subject": {
            "type": "string",
            "title": "Subject"
        }
    },
    "required": ["mode", "subject"],
    "dependencies": {
        "mode": {
            "oneOf": [
                {
                    "properties": {
                        "mode": { "enum": ["sub"] }
                    }
                },
                {
                    "properties": {
                        "mode": { "enum": ["pub"] },
                        "message": { "type": "string" }
                    },
                    "required": ["message"]
                }
            ]
        }
    }
}
