    "type": "object",
    "properties": {
        "mode": {
            "type": "string",
            "title": "Mode",
            "enum": ["pub", "sub"]
        },
        "subject": {
            "type": "string",
            "title": "Subject"
        },
        "message": {
            "title": "Message"
